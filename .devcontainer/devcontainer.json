{
  "image": "mcr.microsoft.com/devcontainers/java:1-17",
  "customizations": {
    "vscode": {
      "extensions": [
        "wpilibsuite.vscode-wpilib@2026.2.1",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle"
      ],
      "settings": {
        "java.import.gradle.java.home": "/usr/lib/jvm/msopenjdk-current",
        "java.configuration.runtimes": [
          { "name": "JavaSE-17", "path": "/usr/lib/jvm/msopenjdk-current", "default": true }
        ]
      }
    }
  }
}